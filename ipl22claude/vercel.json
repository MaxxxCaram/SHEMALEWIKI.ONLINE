{
  "version": 2,
  "public": true,
  "buildCommand": "mkdir -p site && cp -r public/* site/ 2>/dev/null || mkdir -p site && echo '<h1>ShemaleWiki & BuscaTrans</h1>' > site/index.html",
  "outputDirectory": "site",
  "env": {
    "NODE_ENV": "production"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
