{
  "buildCommand": "cd frontend && npm install && npx vite build",
  "outputDirectory": "frontend/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https://qtuzpswxzengqoqqwtpt.supabase.co https://openrouter.ai; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://qtuzpswxzengqoqqwtpt.supabase.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://frontend-cdn.perplexity.ai; img-src 'self' data: blob: https: http:; connect-src 'self' https://qtuzpswxzengqoqqwtpt.supabase.co wss://qtuzpswxzengqoqqwtpt.supabase.co https://shemalewiki.online https://buscatrans.com https://openrouter.ai;"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/image", "destination": "/frontend/api/image.js" },
    { "source": "/api/admin", "destination": "/frontend/api/admin.js" },
    { "source": "/api/admin/login", "destination": "/frontend/api/admin.js" },
    { "source": "/api/register", "destination": "/frontend/api/register.js" },
    { "source": "/api/claims", "destination": "/frontend/api/claims.js" },
    { "source": "/api/contact", "destination": "/frontend/api/contact.js" },
    { "source": "/api/upload-photos", "destination": "/frontend/api/upload-photos.js" },
    { "source": "/api/manage-photos", "destination": "/frontend/api/manage-photos.js" },
    { "source": "/api/update-profile", "destination": "/frontend/api/update-profile.js" },
    { "source": "/api/drafts", "destination": "/frontend/api/profiles.js" },
    { "source": "/api/vivas/chat", "destination": "/frontend/api/profiles.js" },
    { "source": "/api/travel-plans", "destination": "/frontend/api/travel-plans.js" },
    { "source": "/api/auth/login", "destination": "/frontend/api/auth/login.js" },
    { "source": "/api/profiles", "destination": "/frontend/api/profiles.js" },
    { "source": "/api/profiles/(.*)", "destination": "/frontend/api/profiles.js" },
    { "source": "/vivas/_expo/(.*)", "destination": "/frontend/vivas/_expo/$1" },
    { "source": "/vivas/assets/(.*)", "destination": "/frontend/vivas/assets/$1" },
    { "source": "/vivas/favicon.ico", "destination": "/frontend/vivas/favicon.ico" },
    { "source": "/vivas/(.*)", "destination": "/frontend/vivas/index.html" },
    { "source": "/vivas", "destination": "/frontend/vivas/index.html" },
    { "source": "/_expo/(.*)", "destination": "/frontend/vivas/_expo/$1" },
    { "source": "/assets/node_modules/(.*)", "destination": "/frontend/vivas/assets/node_modules/$1" },
    { "source": "/favicon-vivas.ico", "destination": "/frontend/vivas/favicon.ico" },
    { "source": "/(.*)", "destination": "/frontend/index.html" }
  ]
}
