{
  "framework": "vite",
  "buildCommand": "npm install && npx vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/image", "destination": "/api/image.js" },
    { "source": "/api/admin", "destination": "/api/admin.js" },
    { "source": "/api/admin/login", "destination": "/api/admin.js" },
    { "source": "/api/register", "destination": "/api/register.js" },
    { "source": "/api/claims", "destination": "/api/claims.js" },
    { "source": "/api/contact", "destination": "/api/contact.js" },
    { "source": "/api/upload-photos", "destination": "/api/upload-photos.js" },
    { "source": "/api/manage-photos", "destination": "/api/manage-photos.js" },
    { "source": "/api/update-profile", "destination": "/api/update-profile.js" },
    { "source": "/api/drafts", "destination": "/api/profiles.js" },
    { "source": "/api/vivas/chat", "destination": "/api/profiles.js" },
    { "source": "/api/travel-plans", "destination": "/api/travel-plans.js" },
    { "source": "/api/auth/login", "destination": "/api/auth/login.js" },
    { "source": "/api/profiles", "destination": "/api/profiles.js" },
    { "source": "/api/profiles/(.*)", "destination": "/api/profiles.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https://qtuzpswxzengqoqqwtpt.supabase.co https://openrouter.ai; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://qtuzpswxzengqoqqwtpt.supabase.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://frontend-cdn.perplexity.ai; img-src 'self' data: blob: https: http:; connect-src 'self' https://qtuzpswxzengqoqqwtpt.supabase.co wss://qtuzpswxzengqoqqwtpt.supabase.co https://shemalewiki.online https://buscatrans.com https://openrouter.ai;"
        }
      ]
    }
  ]
}
