{
  "expo": {
    "name": "Vivas Nos Queremos",
    "slug": "vivasnosqueremos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "vivasnosqueremos",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.buscatrans.vivasnosqueremos",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para el check-in de seguridad y botón de emergencia.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Tu seguridad es lo primero. Usamos tu ubicación solo durante el check-in y emergencias.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.buscatrans.vivasnosqueremos",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SEND_SMS",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-location",
      "expo-image-picker",
      "expo-notifications"
    ],
    "extra": {
      "supabaseUrl": "https://qtuzpswxzengqoqqwtpt.supabase.co",
      "supabaseAnonKey": "VIVAS_SUPABASE_ANON_KEY_PLACEHOLDER",
      "router": {},
      "eas": {
        "projectId": "d449a0b5-27d1-44e4-9c49-a1e52bb8d777"
      }
    },
    "owner": "missnl"
  }
}
