# ╔══════════════════════════════════════════════════════════════╗
# ║  .env.example - Variables de Entorno para Vercel            ║
# ║  COPIAR como .env.local PARA DESARROLLO LOCAL               ║
# ║  CONFIGURAR en Vercel Dashboard para PRODUCCIÓN             ║
# ╚══════════════════════════════════════════════════════════════╝
#
# INSTRUCCIONES:
# 1. Copiar a .env.local para desarrollo local
# 2. Configurar en: Vercel → Settings → Environment Variables
# 3. NUNCA commitiar este archivo con valores reales

# ──────────────────────────────────────────────────────────────
# SUPABASE
# ──────────────────────────────────────────────────────────────
# URL de la instancia de Supabase
SUPABASE_URL=https://qtuzpswxzengqoqqwtpt.supabase.co

# Service Role Key — PERMISOS COMPLETOS DE BASE DE DATOS
# Rotar si hay exposición: Supabase Dashboard → Project Settings → API
# ⚠️  SECRETO CRÍTICO — si está comprometida, reemplazar inmediatamente
SUPABASE_SERVICE_KEY=

# ──────────────────────────────────────────────────────────────
# SMTP — NOTIFICACIONES POR EMAIL
# ──────────────────────────────────────────────────────────────
# Host y puerto del servidor SMTP (Hostinger por defecto)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465

# Credenciales de email para notificaciones de registro
# ⚠️  SECRETO CRÍTICO — reemplazar si está expuesto
ADS_EMAIL_USER=ads@shemalewiki.online
ADS_EMAIL_PASSWORD=

# ──────────────────────────────────────────────────────────────
# ADMIN — PANEL DE ADMINISTRACIÓN
# ──────────────────────────────────────────────────────────────
# Secret para autenticación del panel admin
# Se usa para POST /api/admin/login → devuelve token JWT
# Generar uno largo y aleatorio mínimo 32 caracteres
# Ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=
